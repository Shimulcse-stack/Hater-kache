rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- AUTHENTICATION & IDENTITY HELPERS ---
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isValidId(docId) {
      return docId is string && docId.size() > 0 && docId.size() <= 128;
    }

    // Connection test document
    match /test/connection {
      allow read, write: if true;
    }

    // --- SECURE PER-USER COLLECTION RULES ---
    match /users/{userId} {
      allow read, write: if true;

      // 1. User Tasks Subcollection
      match /tasks/{taskId} {
        allow read, write: if true;
      }

      // 2. User Custom Bookmarks Subcollection
      match /bookmarks/{bookmarkId} {
        allow read, write: if true;
      }

      // 3. User Scratchpad Memo Subcollection
      match /scratchpad/{scratchId} {
        allow read, write: if true;
      }

      // 4. User Settings & Wallpapers Subcollection
      match /settings/{settingsId} {
        allow read, write: if true;
      }
    }

    // 5. Shared Public Bookmarks Collection
    match /public_bookmarks/{bookmarkId} {
      allow read, write: if true;
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

